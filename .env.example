# Copy this file to .env for local development. Never upload .env or real secrets.
PUBLIC_ORIGIN=http://localhost:8787
PORT=8787
HOST=127.0.0.1
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Cloudflare AI chat. Store real values only in Render Environment or local .env.
# Keep the Cloudflare Workers Free plan for its provider-enforced free allocation.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
# Application request ceiling, NOT a measurement of remaining Cloudflare neurons.
CLOUDFLARE_AI_DAILY_REQUESTS=300
